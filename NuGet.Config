<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    采用标准 NuGet 语义：包还原到当前用户的全局包缓存（Windows 下为 %USERPROFILE%\.nuget\packages）。
    这样删除仓库里的 .packages / packages / obj / bin 都不会丢掉已下载的包，重新还原也很快；
    换一台机器时 NuGet 会自动下载一次，之后同样与仓库目录无关。
    源保持只有 nuget.org；不使用仓库内包目录，也不使用 packages.config。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
