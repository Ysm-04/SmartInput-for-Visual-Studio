<?xml version="1.0" encoding="utf-8"?>
<!-- 此文件用于 XAML 编辑器交互检查，不参与正式构建。 -->
<UserControl x:Class="SmartInputSample.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 标题行：中文说明文字，光标停在这里应为“中文 · 注释”。 -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 普通标签与属性名保持英文；含汉字属性值切中文。 -->
        <TextBlock Grid.Row="0"
                   FontSize="18"
                   Text="输入法设置" />

        <StackPanel Grid.Row="1" Orientation="Vertical">
            <TextBlock Text="智能切换：按代码、注释与字符串自动切换中英文" />
            <TextBox x:Name="UserNameBox"
                     Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     Tag="{Binding 显示名称}" />
            <TextBlock>纯文本内容也随汉字切到中文。</TextBlock>
            <TextBlock>Plain english text stays English.</TextBlock>
            <!-- 英文注释同样推荐中文，与 C# / C++ 规则一致。 -->
            <Button Content="保存" Click="OnSave" />
            <Button Content="Cancel" IsCancel="True" />
            <TextBlock>
                <![CDATA[ CDATA 中文段落：光标在这里应为“中文 · 字符串”。 ]]>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
