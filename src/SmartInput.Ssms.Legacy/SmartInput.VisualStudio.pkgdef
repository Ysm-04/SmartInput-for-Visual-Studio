; Hand-maintained package registration for SSMS 18 / 19 / 20 (32-bit Visual Studio 2017 shell).
; The modern package generates an equivalent file via VSSDK.BuildTools; here it is maintained by
; hand because SSMS 18/19/20 (32-bit isolated shell) do not consume the modern VSIX and the
; legacy build does not produce one; see tools\Deploy-SSMS-Legacy.ps1 for the flat deployment.
; The Tools menu command/menu resource is intentionally omitted (the .vsct is not compiled in the
; legacy build); the status-bar button still provides pause/resume, and all MEF-driven switching works.

[$RootKey$\InstalledProducts\SmartInputPackage]
@="Smart Input"
"PID"="0.3.4.1"
"ProductDetails"="Local input-state switching for Visual Studio and SSMS"
"Package"="{a11d90fc-8f3d-493a-a227-d7a59c26eae8}"

[$RootKey$\Packages\{a11d90fc-8f3d-493a-a227-d7a59c26eae8}]
@="SmartInputPackage"
"InprocServer32"="$WinDir$\SYSTEM32\MSCOREE.DLL"
"Class"="SmartInput.VisualStudio.SmartInputPackage"
"CodeBase"="$PackageFolder$\SmartInput.VisualStudio.dll"
"AllowsBackgroundLoad"=dword:00000001

; UIContext_NoSolution: the SSMS isolated shell raises this at startup (there is never a VS
; solution), so the package loads early and initializes user settings before a query window opens.
[$RootKey$\AutoLoadPackages\{adfc4e64-0397-11d1-9f4e-00a0c911004f}]
"{a11d90fc-8f3d-493a-a227-d7a59c26eae8}"=dword:00000002

[$RootKey$\ToolsOptionsPages\Smart Input]
@="#0"
"Package"="{a11d90fc-8f3d-493a-a227-d7a59c26eae8}"
[$RootKey$\ToolsOptionsPages\Smart Input\常规]
@="#0"
"Package"="{a11d90fc-8f3d-493a-a227-d7a59c26eae8}"
"Page"="{639700d9-2398-35c0-8998-3d63fd3d3223}"
"IsServerAware"=dword:00000000
"IsInUnifiedSettings"=dword:00000000

[$RootKey$\AutomationProperties\Smart Input]
"Package"="{a11d90fc-8f3d-493a-a227-d7a59c26eae8}"
[$RootKey$\AutomationProperties\Smart Input\常规]
"Package"="{a11d90fc-8f3d-493a-a227-d7a59c26eae8}"
[$RootKey$\AutomationProperties\Smart Input\常规]
"Name"="SmartInput.常规"