  <Target Name="SyncVsixManifestIdentity"
          AfterTargets="DetokenizeVsixManifestFile"
          BeforeTargets="CopyVsixManifestFile;CreateVsixContainer"
          Condition="Exists('$(IntermediateVsixManifest)') and Exists('source.extension.vsixmanifest')">
    <XmlPeek XmlInputPath="source.extension.vsixmanifest"
             Query="/v:PackageManifest/v:Metadata/v:Identity/@Id"
             Namespaces="&lt;Namespace Prefix='v' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;">
      <Output TaskParameter="Result" PropertyName="_SourceVsixId" />
    </XmlPeek>
    <XmlPeek XmlInputPath="source.extension.vsixmanifest"
             Query="/v:PackageManifest/v:Metadata/v:Identity/@Version"
             Namespaces="&lt;Namespace Prefix='v' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;">
      <Output TaskParameter="Result" PropertyName="_SourceVsixVersion" />
    </XmlPeek>
    <Error Condition="'$(_SourceVsixId)' == '' or '$(_SourceVsixVersion)' == ''"
           Text="Could not read the VSIX identity from source.extension.vsixmanifest." />
    <XmlPoke XmlInputPath="$(IntermediateVsixManifest)"
             Query="/v:PackageManifest/v:Metadata/v:Identity/@Id"
             Value="$(_SourceVsixId)"
             Namespaces="&lt;Namespace Prefix='v' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;" />
    <XmlPoke XmlInputPath="$(IntermediateVsixManifest)"
             Query="/v:PackageManifest/v:Metadata/v:Identity/@Version"
             Value="$(_SourceVsixVersion)"
             Namespaces="&lt;Namespace Prefix='v' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;" />
  </Target>
