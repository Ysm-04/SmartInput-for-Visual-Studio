<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">AnyCPU</Platform>
    <ProjectGuid>{2B0F8428-8965-4110-96FC-62B8897A3935}</ProjectGuid>
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{fae04ec0-301f-11d3-bf4b-00c04f79efbc}</ProjectTypeGuids>
    <OutputType>Library</OutputType>
    <RootNamespace>SmartInput.VisualStudio</RootNamespace>
    <AssemblyName>SmartInput.VisualStudio</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DebugType>portable</DebugType>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CreateVsixContainer>true</CreateVsixContainer>
    <DeployExtension>false</DeployExtension>
    <CopyVsixExtensionFiles>false</CopyVsixExtensionFiles>
    <UseCodebase>true</UseCodebase>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <!--
      Locate the VSSDK MSBuild targets belonging to the MSBuild that is running this build.
      VS 2022 installs them under Microsoft\VisualStudio\v17.0, VS 2026 under v18.0 (and later
      versions will use their own folder). Hard-coding v17.0 made the whole VSIX / CreatePkgDef
      step silently disappear on a machine that only has VS 2026: the conditional import below
      then resolved to a non-existent path, the build still "succeeded", but no .vsix was
      produced. Prefer whichever versioned targets really exist, newest first, and keep v17.0 as
      the historical fallback for build servers that only restore the VSSDK 17 packages.
    -->
    <VSToolsPath Condition="'$(VSToolsPath)' == '' AND Exists('$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v19.0\VSSDK\Microsoft.VsSDK.targets')">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v19.0</VSToolsPath>
    <VSToolsPath Condition="'$(VSToolsPath)' == '' AND Exists('$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v18.0\VSSDK\Microsoft.VsSDK.targets')">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v18.0</VSToolsPath>
    <VSToolsPath Condition="'$(VSToolsPath)' == '' AND Exists('$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v17.0\VSSDK\Microsoft.VsSDK.targets')">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v17.0</VSToolsPath>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v17.0</VSToolsPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Design" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xaml" />
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <!--
      All Visual Studio editor/shell reference assemblies come from the OFFICIAL VSSDK 17 NuGet
      packages - the same pattern the SSMS Legacy project already uses for VSSDK 15. We deliberately
      do NOT add <Reference><HintPath> entries into VSSDK.BuildTools' tools\vssdk folder: those paths
      are hard-wired to the repo-local .packages folder AND to that package's internal layout (some
      sibling assemblies, e.g. Microsoft.VisualStudio.Utilities, live under tools\vssdk\bin\lib,
      which assembly resolution never searches). Such HintPaths break in the Visual Studio IDE
      design-time build whenever package restore has not finished or puts packages in the global
      cache instead of .packages, and then every 'using Microsoft.VisualStudio.*' is flagged as
      "type or namespace does not exist", even though the command-line build happens to succeed.

      NuGet PackageReference instead supplies the same assemblies through $(NuGetPackageRoot)
      absolute paths in BOTH the command-line build and the IDE design-time build, regardless of
      where the packages are restored. The Shell.15.0 package pulls Utilities, ComponentModelHost,
      Interop, Imaging and the remaining shell assemblies in through its normal dependency closure
      (the same reason the Legacy project needs no explicit Utilities reference). ExcludeAssets/
      PrivateAssets=runtime keeps every host DLL out of the output and the VSIX; VSSDK.BuildTools
      remains only as the packaging toolset (CreatePkgDef, VSIX container, .vsct compilation).
    -->
    <PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="17.14.249" ExcludeAssets="runtime" PrivateAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" ExcludeAssets="runtime" PrivateAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.Framework" Version="17.14.40264" ExcludeAssets="runtime" PrivateAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Threading" Version="17.14.15" ExcludeAssets="runtime" PrivateAssets="runtime" />
    <PackageReference Include="Microsoft.VisualStudio.Imaging.Interop.14.0.DesignTime" Version="17.14.40254" ExcludeAssets="runtime" PrivateAssets="runtime" />
    <!-- The VSSDK 17.14 shell closure (Shell.15.0/Shell.Framework/Utilities/Imaging/Threading and
         System.Text.Json 9.0) requires Microsoft.Bcl.AsyncInterfaces 9.0.0. Pinning 8.0.0 here makes
         NuGet restore 8.0.0 as the primary reference while the VS host's PublicAssemblies and the
         transitive packages unify to 9.0.0.0, raising MSB3277. Keep this at 9.0.0 to match the
         Visual Studio 2022 17.14 / SSMS 22 host (which ships Microsoft.Bcl.AsyncInterfaces
         9.0.0.0); ExcludeAssets=runtime means it is compiled against but never copied into the
         VSIX - the host provides it at run time. -->
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="9.0.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" PrivateAssets="all" />
    <ProjectReference Include="..\SmartInput.Core\SmartInput.Core.csproj">
      <Project>{0E46424E-6D93-4079-9344-0B20FFB09BF0}</Project>
      <Name>SmartInput.Core</Name>
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup</IncludeOutputGroupsInVSIX>
    </ProjectReference>
    <Compile Include="*.cs" />
    <VSCTCompile Include="SmartInputCommands.vsct" />
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

  <Target Name="SyncVsixManifestIdentity"
          AfterTargets="DetokenizeVsixManifestFile"
          BeforeTargets="CopyVsixManifestFile;CreateVsixContainer"
          Condition="Exists('$(IntermediateVsixManifest)') and Exists('source.extension.vsixmanifest')">
    <XmlPeek XmlInputPath="source.extension.vsixmanifest"
             Query="/v:PackageManifest/v:Metadata/v:Identity/@Id"
             Namespaces="&lt;Namespace Prefix='v' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;">
      <Output TaskParameter="Result" PropertyName="_SourceVsixId" />
    </XmlPeek>
    <XmlPeek XmlInputPath="source.extension.vsixmanifest"
             Query="/v:PackageManifest/v:Metadata/v:Identity/@Version"
             Namespaces="&lt;Namespace Prefix='v' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;">
      <Output TaskParameter="Result" PropertyName="_SourceVsixVersion" />
    </XmlPeek>
    <Error Condition="'$(_SourceVsixId)' == '' or '$(_SourceVsixVersion)' == ''"
           Text="Could not read the VSIX identity from source.extension.vsixmanifest." />
    <XmlPoke XmlInputPath="$(IntermediateVsixManifest)"
             Query="/v:PackageManifest/v:Metadata/v:Identity/@Id"
             Value="$(_SourceVsixId)"
             Namespaces="&lt;Namespace Prefix='v' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;" />
    <XmlPoke XmlInputPath="$(IntermediateVsixManifest)"
             Query="/v:PackageManifest/v:Metadata/v:Identity/@Version"
             Value="$(_SourceVsixVersion)"
             Namespaces="&lt;Namespace Prefix='v' Uri='http://schemas.microsoft.com/developer/vsx-schema/2011' /&gt;" />
  </Target>
</Project>